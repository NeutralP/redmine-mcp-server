# Redmine MCP Configuration
# Copy this file to .env and update the values

# Authentication Options:
# Option 1: Username and Password (traditional)
# Browser-facing Redmine URL — used for the OAuth /authorize redirect and
# advertised in OAuth metadata. The user's browser must be able to reach it.
REDMINE_URL=https://your-redmine-server.com

# Server-to-server Redmine URL (optional). Set this when the MCP server runs
# in Docker on the same host as Redmine — `localhost` inside a container
# points at the container itself, not the host. On Docker Desktop
# (Windows/macOS), `host.docker.internal` resolves to the host.
# REDMINE_INTERNAL_URL=http://host.docker.internal:8080

REDMINE_USERNAME=your_username
REDMINE_PASSWORD=your_password


# Option 2: API Key (alternative to username/password)
# Uncomment and set this if you want to use API key authentication instead
# REDMINE_API_KEY=your_api_key

# Authentication mode: "oauth" or "legacy" (default: legacy)
# - legacy: uses REDMINE_API_KEY or REDMINE_USERNAME/REDMINE_PASSWORD below
# - oauth:  this server fronts Redmine's OAuth as a DCR-capable proxy so that
#           MCP clients (Claude Desktop, Codex CLI, VS Code, Claude Code) can
#           connect without manual client_id/client_secret configuration.
REDMINE_AUTH_MODE=legacy

# OAuth2 configuration (only required when REDMINE_AUTH_MODE=oauth)
# Public base URL of this MCP server (no trailing slash). Used as the OAuth
# issuer and to compute the upstream redirect URI <REDMINE_MCP_BASE_URL>/auth/callback.
# e.g. https://redmine.mcp.example.com or http://localhost:8000
REDMINE_MCP_BASE_URL=http://localhost:8000

# Static Redmine OAuth application credentials (Admin > Applications > New).
# Register with redirect URI = <REDMINE_MCP_BASE_URL>/auth/callback and
# Confidential = Yes. ALL MCP clients are bridged through this single app.
REDMINE_OAUTH_CLIENT_ID=
REDMINE_OAUTH_CLIENT_SECRET=

# Space-separated Redmine permission names to request as OAuth scopes.
# These are advertised in /.well-known metadata AND used as the default
# `scope=` param when an MCP client doesn't request one of its own. They
# are also enforced per request: a token missing a required scope is
# rejected with 403 insufficient_scope.
#
# Leaving this unset is almost never what you want: Redmine's Doorkeeper
# default_scopes is just `view_project search_project view_members` (the
# three public read permissions), so every write tool will return 403.
#
# The list below is the minimum union across all MCP tools, excluding
# `admin`. `list_redmine_users` and `list_redmine_roles` will still 403
# because Redmine gates those APIs to admins regardless of scope.
#
# Every scope listed here must also be enabled on the OAuth application
# in Redmine (Admin -> Applications -> <your app>) — Doorkeeper enforces
# `enforce_configured_scopes`, so unknown scopes fail with invalid_scope.
# REDMINE_OAUTH_SCOPES=view_project search_project view_members view_issues add_issues edit_issues edit_own_issues copy_issues manage_subtasks manage_issue_relations add_issue_notes edit_issue_notes edit_own_issue_notes view_private_notes set_notes_private view_issue_watchers add_issue_watchers delete_issue_watchers manage_categories manage_versions manage_members view_wiki_pages edit_wiki_pages delete_wiki_pages rename_wiki_pages view_files manage_files view_time_entries log_time edit_time_entries edit_own_time_entries log_time_for_other_users import_time_entries view_gantt

# Server configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Public URL configuration for file serving
# External hostname/IP for generated download URLs
PUBLIC_HOST=localhost
PUBLIC_PORT=8000

# File Management (Optional)
# Directory where downloaded attachments are stored
ATTACHMENTS_DIR=./attachments

# Automatic cleanup configuration
AUTO_CLEANUP_ENABLED=true
CLEANUP_INTERVAL_MINUTES=10

# Default expiry time for downloaded attachments (in minutes)
ATTACHMENT_EXPIRES_MINUTES=60

# Read-only mode (optional)
# When enabled, write operations (create/update/delete) are blocked
# REDMINE_MCP_READ_ONLY=false

# RedmineUP Agile plugin support (optional)
# Set to true to include story_points, agile_sprint_id, agile_position in
# get_redmine_issue responses and allow story_points in update_redmine_issue.
# Requires the RedmineUP Agile plugin installed and the 'agile' module enabled
# per project (Project Settings → Modules → Agile).
# REDMINE_AGILE_ENABLED=false

# RedmineUP Checklists plugin support (optional)
# Set to true to enable the get_checklist and update_checklist_item tools.
# Requires the RedmineUP Checklists Pro plugin installed on your Redmine
# instance.
# REDMINE_CHECKLISTS_ENABLED=false

# RedmineUP Products plugin support (optional)
# Set to true to enable the manage_product tool (action=list/get/create/update).
# Requires the RedmineUP Products plugin installed on your Redmine instance.
# REDMINE_PRODUCTS_ENABLED=false

# RedmineUP CRM (Contacts) plugin support (optional)
# Set to true to enable the manage_contact tool
# (action=list/get/create/update/delete/assign_to_project/remove_from_project).
# Requires the RedmineUP CRM plugin installed on your Redmine instance.
# REDMINE_CRM_ENABLED=false

# Required custom field autofill (optional)
# Retries once on relevant create/update validation errors (blank/invalid custom fields)
# REDMINE_AUTOFILL_REQUIRED_CUSTOM_FIELDS=false
# REDMINE_REQUIRED_CUSTOM_FIELD_DEFAULTS={}

# SSL Certificate Configuration (Optional)
# Enable/disable SSL certificate verification (default: true)
# WARNING: Only set to false for development/testing environments!
REDMINE_SSL_VERIFY=true

# Path to custom CA certificate file for self-signed certificates
# Supports .pem, .crt, .cer formats
# Example: REDMINE_SSL_CERT=/path/to/ca-bundle.crt
# REDMINE_SSL_CERT=

# Client certificate for mutual TLS authentication
# Single file: REDMINE_SSL_CLIENT_CERT=/path/to/client.pem
# Separate cert and key: REDMINE_SSL_CLIENT_CERT=/path/to/cert.pem,/path/to/key.pem
# Note: Private keys must be unencrypted
# REDMINE_SSL_CLIENT_CERT=
